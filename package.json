{
  "name": "talentiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TalentIQ — a simple local hiring workspace for candidates, job openings and resume screening.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
