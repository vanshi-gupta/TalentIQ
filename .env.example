# ── Server ─────────────────────────────────────────────
PORT=5173
NODE_ENV=development
APP_BASE_URL=http://localhost:5173

# ── Authentication & Session Security ──────────────────
# Set a strong random secret in production (minimum 32 chars).
AUTH_SECRET=change-this-local-dev-secret-before-production

# ── Local SQLite storage ───────────────────────────────
# Relative paths resolve from the project root.
DATABASE_PATH=./data/talentiq.db
UPLOADS_DIR=./data/uploads
MAX_FILE_SIZE_MB=10

# ── Optional sample data ───────────────────────────────
# Off by default. New installs start with an empty workspace.
# Set to true only when you want labelled demo records.
SEED_DEMO_DATA=false

# ── Razorpay Standard Checkout (UPI / Cards / NetBanking) ─
# Test mode: use rzp_test_... credentials from Razorpay Dashboard -> Settings -> API Keys.
# Live mode: switch to rzp_live_... credentials and update RAZORPAY_WEBHOOK_SECRET from live webhooks.
# Leave blank when payment credentials are not yet configured; checkout will explain configuration needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Optional Google Gemini AI ──────────────────────────
# Leave blank to use TalentIQ's deterministic local engine only.
# The key is read exclusively by the backend and never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
